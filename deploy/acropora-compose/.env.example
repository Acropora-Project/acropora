# ═══════════════════════════════════════════════════════════
# Acropora Node Configuration
# Copy to .env and fill in your values.
# Run ./scripts/setup.sh for guided setup.
# ═══════════════════════════════════════════════════════════

CORAL_NODE_NAME="My Acropora Node"

# ── SDR / receiver ──────────────────────────────────────────
RTL_DEVICE_INDEX=0
RTL_GAIN=40
RECEIVER_LAT=32.9
RECEIVER_LON=-97.0

# ── readsb mode ─────────────────────────────────────────────
# bundled  = acropora-compose starts its own readsb
# native   = readsb already running on this host
# external = readsb running in another Docker container
READSB_MODE=bundled
READSB_VOLUME_MOUNT=readsb-data
READSB_AIRCRAFT_JSON=/run/readsb/aircraft.json

# ── Privacy ─────────────────────────────────────────────────
PRIVACY_PRESET=private_contributor
EXCLUSION_ZONE_KM=25
COORDINATE_DP=2
RSSI_MODE=strip
EMBARGO_MINUTES=0

# ── Query policy ────────────────────────────────────────────
MAX_QUERY_TIME_RANGE_HOURS=24
MAX_QUERY_BBOX_DEGREES=5.0
MAX_QUERY_RADIUS_KM=500
MAX_RECORDS_PER_QUERY=10000
RATE_LIMIT_RPM=60
ACCESS_MODE=public

# ── Storage ─────────────────────────────────────────────────
HOT_RETENTION_DAYS=90
COMPRESS_AFTER_DAYS=7
ARCHIVE_ENABLED=true
ARCHIVE_AFTER_DAYS=85
ARCHIVE_PATH=/var/lib/acropora/archive

# ── Network ─────────────────────────────────────────────────
CORAL_API_PORT=5000
CORAL_DASHBOARD_PORT=5001
CORAL_PUBLIC_HOSTNAME=
DISCOVERABLE=true
CORAL_REGISTRIES=

# ── Database (generated by setup.sh — do not set manually) ──
POSTGRES_USER=acropora_node
POSTGRES_PASSWORD=
POSTGRES_DB=acropora